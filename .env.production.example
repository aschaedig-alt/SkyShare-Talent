NEXT_PUBLIC_APP_ENV="staging"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skyshare_talent_ops?schema=public"
FILE_STORAGE_PROVIDER="s3"
REQUIRE_PRIVATE_FILE_STORAGE="true"
AWS_REGION="us-east-1"
S3_CANDIDATE_FILES_BUCKET="skyshare-talent-ops-candidate-files"
AWS_ACCESS_KEY_ID="replace-with-s3-limited-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-s3-limited-secret"
AUTH_PROVIDER="google-workspace"
REQUIRE_AUTH="true"
NEXTAUTH_URL="https://your-production-domain.example.com"
NEXTAUTH_SECRET="replace-with-random-32-plus-character-secret"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
AUTH_ADMIN_EMAILS="owner@example.com"
AUTH_ALLOWED_EMAILS=""
AUTH_ALLOWED_DOMAINS="skyshare.example"
