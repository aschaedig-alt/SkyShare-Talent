{
  "name": "skyshare-talent-ops",
  "description": "Unified SkyShare recruiting operations workspace for candidates, jobs, pilot requirements, publishing, and scheduling.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx prisma/ensure-dev-db.ts && next dev",
    "build": "prisma generate && next build",
    "build:hosted": "npm run db:postgres:schema && prisma generate --schema prisma/schema.postgres.prisma && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:import-master": "prisma generate && tsx prisma/import-master-jobs.ts",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:postgres:schema": "tsx scripts/create-postgres-schema.ts",
    "db:hosted:push": "npm run db:postgres:schema && prisma db push --schema prisma/schema.postgres.prisma",
    "db:hosted:generate": "npm run db:postgres:schema && prisma generate --schema prisma/schema.postgres.prisma",
    "prod:check": "tsx scripts/check-production-readiness.ts",
    "prod:check:strict": "tsx scripts/check-production-readiness.ts --strict"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.19",
    "next-auth": "^4.24.14",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
