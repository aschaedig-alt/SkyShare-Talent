#!/bin/sh
#
# Pre-push gate: ESLint must be clean before anything reaches main.
#
# WHY. Pushing to main auto-deploys, and next build runs ESLint and FAILS on
# errors (next.config.mjs does not set eslint.ignoreDuringBuilds). On 2026-07-28
# three "Unexpected any" errors reached main and every deploy after them failed
# silently for hours — production kept serving older code while several sessions
# believed their work was live. Nobody noticed until Vercel emailed.
#
# Lint only, on purpose. It takes ~28s and catches exactly that failure class.
# Typecheck is another ~21s and has never been the thing that broke a deploy;
# add it here if that changes.
#
# Escape hatch: git push --no-verify. That is for a human making a deliberate
# call. CLAUDE.md forbids agents from using it.

# Nothing staged for push (e.g. deleting a remote branch) — let it through.
if [ -z "$(git rev-parse --verify HEAD 2>/dev/null)" ]; then
  exit 0
fi

printf '\n[pre-push] running ESLint before pushing to a branch that auto-deploys...\n'

# ESLint OOMs on this project under memory pressure (a dev server running is
# enough to do it) and node then exits 134, which is NOT a lint failure. Same
# heap bump the build and typecheck already need — see CLAUDE.md.
NODE_OPTIONS="${NODE_OPTIONS} --max-old-space-size=8192"
export NODE_OPTIONS

npm run --silent lint
STATUS=$?

if [ "$STATUS" -eq 0 ]; then
  printf '[pre-push] lint clean — pushing.\n\n'
  exit 0
fi

# ESLint exits 1 when it found lint errors. Anything else means the tool itself
# fell over, and saying "you have lint errors" would send you hunting for a bug
# that isn't there.
if [ "$STATUS" -eq 1 ]; then
  cat <<'MSG'

────────────────────────────────────────────────────────────────────────
  PUSH BLOCKED — ESLint reported errors (warnings are fine).

  These would fail the Vercel build, which means production silently
  keeps serving older code. Fix them, or push with --no-verify if you
  are deliberately shipping past a known state.

  Reproduce with:      npm run lint
  Full build check:     npm run build:check
────────────────────────────────────────────────────────────────────────

MSG
else
  cat <<MSG

────────────────────────────────────────────────────────────────────────
  PUSH BLOCKED — ESLint could not finish (exit ${STATUS}).

  This is the tool failing, not your code. Exit 134 or a "heap out of
  memory" message means it ran out of memory: stop any dev server and
  try again. Failing closed on purpose — an unrunnable check is not a
  passing one.

  Retry with:          npm run lint
  Deliberate override: git push --no-verify
────────────────────────────────────────────────────────────────────────

MSG
fi
exit 1
