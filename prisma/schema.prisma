generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model JobPost {
  id                 String             @id @default(cuid())
  title              String
  internalName       String?
  department         String?
  category           String?
  location           String?
  secondaryLocation  String?
  positionType       String?
  salaryRange        String?
  reportsTo          String?
  positionCode       String?
  seatCode           String?
  travelPercentage   String?
  educationLevel     String?
  workSchedule       String?
  summary            String?
  keyResponsibilities String?
  qualificationsText String?
  benefitsText       String?
  postedDate         DateTime?
  status             String             @default("DRAFT")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  recruitingJobId    String?
  pilotRequirementId String?

  paycom             PaycomConfig?
  recruitingJob      Job?               @relation("RecruitingJobToJobPosts", fields: [recruitingJobId], references: [id], onDelete: SetNull)
  pilotRequirement   PilotRequirement?  @relation("PilotRequirementToJobPosts", fields: [pilotRequirementId], references: [id], onDelete: SetNull)
  blockInstances     JobBlockInstance[]
}

model PaycomConfig {
  id                    String   @id @default(cuid())
  jobPostId             String   @unique
  workflow              String?
  externalApplication   String?
  externalKnockout      String?
  externalGlobal        String?
  externalJobLevel      String?
  externalFollowUps     String?
  internalApplication   String?
  internalKnockout      String?
  internalGlobal        String?
  internalJobLevel      String?

  jobPost               JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
}

model ContentBlock {
  id               String                @id @default(cuid())
  name             String
  description      String?
  category         String
  scope            String
  placement        String                @default("OPTIONAL")
  currentVersionId String?
  archivedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  versions         ContentBlockVersion[]  @relation("BlockVersions")
  usages           JobBlockInstance[]
}

model ContentBlockVersion {
  id             String             @id @default(cuid())
  contentBlockId String
  versionNumber  Int
  title          String
  body           String
  plainText      String?
  bodyFormat     String             @default("BULLET_LIST")
  textWeight     String             @default("NORMAL")
  textColor      String             @default("BLACK")
  createdAt      DateTime           @default(now())
  changeNote     String?

  contentBlock   ContentBlock       @relation("BlockVersions", fields: [contentBlockId], references: [id], onDelete: Cascade)
  jobInstances   JobBlockInstance[]

  @@unique([contentBlockId, versionNumber])
}

model JobBlockInstance {
  id              String               @id @default(cuid())
  jobPostId       String
  contentBlockId  String?
  blockVersionId  String?
  sortOrder       Int
  sectionKey      String
  mode            String               @default("LINKED")
  customTitle     String?
  customBody      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  jobPost         JobPost              @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  contentBlock    ContentBlock?        @relation(fields: [contentBlockId], references: [id], onDelete: SetNull)
  blockVersion    ContentBlockVersion? @relation(fields: [blockVersionId], references: [id], onDelete: SetNull)
}

model Template {
  id          String          @id @default(cuid())
  name        String
  isLocked    Boolean         @default(true)
  version     Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tokens      TemplateToken[]
}

model TemplateToken {
  id          String    @id @default(cuid())
  templateId  String
  key         String
  value       String
  locked      Boolean   @default(true)

  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model User {
  id          String       @id @default(cuid())
  name        String?
  email       String?      @unique
  emailVerified DateTime?
  image       String?
  role        String       @default("VIEWER")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  notes         CandidateNote[]
  auditEvents   AuditEvent[]
  permissions   UserPermission[]
  activityLogs  ActivityLog[]    @relation("ActivityLogs")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceSetting {
  id          String   @id @default(cuid())
  scope       String   @default("workspace")
  key         String
  valueJson   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
}

// A revocable, unguessable public link to a live read-only report (currently the
// Fleet Progression report). Anyone with the token can view; an admin can revoke.
model ReportShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  report    String    @default("fleet-progression")
  label     String?
  createdBy String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model NewHire {
  id              String   @id @default(cuid())
  name            String
  // Preferred/display name (the `name` field) is what shows everywhere. When someone
  // goes by a different name than their legal one, their full legal name lives here
  // and is shown only on their profile (e.g. display "Wren Carter" / legal "Lauren Stephani Carter").
  legalName       String?
  position        String?
  department      String?
  // Home base / work location (SVR, SLC, OGD, DVO, HND, Home-Based, ...).
  location        String?
  // Tail number for pilots dedicated to a managed aircraft (e.g. "N366FB").
  managedAircraft String?
  // Dedicated managed-aircraft pilot (not part of the SkyShare / fractional shared
  // pool). Excluded by default from fleet-progression / promotion tracking, since a
  // managed-account pilot isn't on a promote-by-date path. Editable per pilot.
  managedPilot    Boolean  @default(false)
  phone           String?
  ssEmail         String?
  personalEmail   String?
  // Cross-cutting person labels shown as pills (Executive, Management, ...),
  // independent of department — a person can carry more than one. Hand-applied.
  // "Contract" is NOT stored here; it's derived from employmentStatus at display.
  tags            String[]
  offerSentDate   DateTime?
  offerSignedDate DateTime?
  startDate       DateTime?
  // Pilots: the date their current pay step is anchored to — usually their hire
  // date, but reset when they move to a new airframe. Drives the annual
  // pay-increase anniversary (PAF reminders are a later, separate feature).
  aircraftServiceDate DateTime?
  orientationDate DateTime?
  // Last day with SkyShare — set for former employees (employmentStatus TERMINATED).
  terminationDate DateTime?
  // Date of birth — dates only, used for recognition/"congrats" (no other PII stored).
  birthday        DateTime?
  // Pilot seniority anchor (from HR). Usually the hire date, but can be kept at
  // the original hire OR reset to a rehire date depending on the break — so it's
  // stored explicitly rather than derived. birth/citizenship country from HR too.
  seniorityDate   DateTime?
  birthCountry       String?
  citizenshipCountry String?
  // Lifecycle: ACTIVE (being onboarded) -> POST_ONBOARD (maintenance) -> ARCHIVED
  stage            String   @default("ACTIVE")
  onboardedAt      DateTime?
  // Employment status once onboarded: ACTIVE | TERMINATED
  employmentStatus String   @default("ACTIVE")
  // How many times this hire has been moved/rescheduled to a later orientation.
  orientationRescheduleCount Int @default(0)
  canceled         Boolean  @default(false)
  travelStatus    String?
  // Business-card ordering: NEEDED (default) | ORDERED | RECEIVED | NOT_NEEDED.
  // Ordered in bulk ~1-2 weeks before orientation (see lib/business-cards).
  businessCardStatus String @default("NEEDED")
  // Card-title override for the primary business card. Blank => defaults to
  // "Pilot" for flight-deck crew, else the profile position (see defaultCardTitle).
  businessCardTitle  String?
  // Travel loyalty numbers — auto-pulled into new trips (see TravelTrip).
  frequentFlyer   String?
  hotelLoyalty    String?
  rentalLoyalty   String?
  notes           String?
  candidateId     String?
  importKey       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Compliments by SkyShare — recognition & rewards (new hires are the employees)
  pointsBalance   Int      @default(0)   // redeemable points balance
  avatarInitials  String?                // initials chip; derived from name if absent

  // Pilot Development Program graduate (completed PDP + moved to Captain). Shows a
  // star on the profile. Set manually — currently a small, hand-picked group.
  pdpGraduate     Boolean  @default(false)

  tasks           OnboardingTask[]
  orientationAttendances OrientationAttendee[]
  travelTrips     TravelTrip[]
  roleAssignments RoleAssignment[]
  employmentStints EmploymentStint[]

  recognitionsGiven    Recognition[] @relation("giver")
  recognitionsReceived Recognition[] @relation("recipient")
  redemptions          Redemption[]
  businessCardVariants BusinessCardVariant[]
  eventAttendances     EventAttendee[]
  eventsOwned          Event[]

  @@index([stage])
}

// A secondary business card for an employee (e.g. a recruiting card with its own
// phone/email). The employee's PRIMARY card is derived from their profile; these
// are extra cards, each overriding whatever differs. Blank fields fall back to
// the primary/profile value.
model BusinessCardVariant {
  id        String   @id @default(cuid())
  newHireId String
  label     String // e.g. "Recruiting"
  title     String?
  skyops    String?
  mobile    String?
  email     String?
  web       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  newHire NewHire @relation(fields: [newHireId], references: [id], onDelete: Cascade)

  @@index([newHireId])
}

// One role an employee has held at SkyShare (their journey). A person's current
// role has endDate = null. transitionType classifies how they got there; an
// "UPGRADE" is specifically a seat change SIC -> PIC (first officer -> captain),
// which drives the pilot upgrade analytics. Pilot seats tie to the fleet
// registry via fleetPositionSlug/seat; non-pilot roles just carry a title.
model RoleAssignment {
  id                String    @id @default(cuid())
  newHireId         String
  newHire           NewHire   @relation(fields: [newHireId], references: [id], onDelete: Cascade)
  title             String
  fleetPositionSlug String?
  seat              String?   // PIC | SIC | null (non-pilot)
  aircraft          String?
  department        String?
  startDate         DateTime
  endDate           DateTime? // null = current role
  transitionType    String    @default("HIRE") // HIRE | PROMOTION | UPGRADE | LATERAL | TRANSFER
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([newHireId])
}

// One period of employment (a "stint"). Most people have one; a rehire has two+
// (they left and came back). endDate null = currently employed in this stint.
// Tenure sums stint durations; the timeline shows the leave/return gap.
model EmploymentStint {
  id         String    @id @default(cuid())
  newHireId  String
  newHire    NewHire   @relation(fields: [newHireId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime? // null = current
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([newHireId])
}

model OrientationSession {
  id        String   @id @default(cuid())
  date      DateTime
  location  String?  @default("SkyShare HQ, Salt Lake City")
  address   String?
  meetLink  String?
  notes     String?
  status    String   @default("UPCOMING") // UPCOMING | COMPLETE | CANCELED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees OrientationAttendee[]
  prepTasks OrientationPrepTask[]

  @@index([status])
}

model OrientationAttendee {
  id               String   @id @default(cuid())
  sessionId        String
  newHireId        String
  confirmed        String   @default("PENDING") // PENDING | CONFIRMED | DECLINED
  travelStatus     String   @default("NA")       // NA (local) | NEEDED | ARRANGED
  ipadReady        Boolean  @default(false)
  cardReady        Boolean  @default(false)
  swagReady        Boolean  @default(false)
  sentTemplateKeys String   @default("[]")
  notes            String?
  createdAt        DateTime @default(now())

  session OrientationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  newHire NewHire            @relation(fields: [newHireId], references: [id], onDelete: Cascade)

  @@unique([sessionId, newHireId])
  @@index([sessionId])
}

model OrientationPrepTask {
  id            String    @id @default(cuid())
  sessionId     String
  label         String
  owner         String?
  dueDaysBefore Int?
  order         Int
  done          Boolean   @default(false)
  completedAt   DateTime?

  session OrientationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model OnboardingTask {
  id          String    @id @default(cuid())
  newHireId   String
  key         String
  label       String
  group       String
  order       Int
  // TODO (not done) | DONE | NA (not applicable, e.g. pilot-only tasks for ground crew)
  status      String    @default("TODO")
  completedAt DateTime?

  newHire     NewHire   @relation(fields: [newHireId], references: [id], onDelete: Cascade)

  @@unique([newHireId, key])
  @@index([newHireId])
}

// Travel & logistics — flights, rental cars, hotels, and receipts SkyShare
// books for a new hire (orientation / indoc) or a candidate (pre-hire fly-out).
// Exactly one of newHireId / candidateId is set per trip. Supersedes the loose
// travelStatus flag on NewHire / OrientationAttendee.
model TravelTrip {
  id          String    @id @default(cuid())
  newHireId   String?
  candidateId String?
  // ORIENTATION | INDOC | TRAINING | INTERVIEW | RECRUITING_VISIT | OTHER
  purpose     String    @default("ORIENTATION")
  // NEEDED | BOOKED | COMPLETED | CANCELED
  status      String    @default("NEEDED")

  // Request side — what the traveler needs (mirrors the pilot travel form).
  originAirport       String?
  destinationAirport  String?
  orientationDate     DateTime?
  indocStart          DateTime?
  indocEnd            DateTime?
  requestedArrival    DateTime?
  requestedReturn     DateTime?
  preferredAirline    String?
  frequentFlyer       String?
  hotelLoyalty        String?
  rentalLoyalty       String?
  preferences         String?
  additionalTransport String?
  specialRequests     String?

  notes       String?
  bookedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  newHire   NewHire?        @relation(fields: [newHireId], references: [id], onDelete: Cascade)
  candidate Candidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  items     TravelItem[]
  receipts  TravelReceipt[]

  @@index([newHireId])
  @@index([candidateId])
  @@index([status])
}

// A single booked thing on a trip: a flight, rental car, hotel, etc.
model TravelItem {
  id           String    @id @default(cuid())
  tripId       String
  // FLIGHT | CAR | HOTEL | TRANSPORT | OTHER
  type         String    @default("FLIGHT")
  vendor       String?
  confirmation String?
  detail       String?
  startsAt     DateTime?
  endsAt       DateTime?
  amount       Float?
  currency     String    @default("USD")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// A receipt / confirmation document attached to a trip (and optionally a item).
model TravelReceipt {
  id               String   @id @default(cuid())
  tripId           String
  itemId           String?
  originalFilename String
  displayFilename  String
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  amount           Float?
  uploadedAt       DateTime @default(now())

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Feedback {
  id          String   @id @default(cuid())
  type        String   @default("IDEA")
  message     String
  // Pathname only (kept for existing rows + quick display). The full URL with its
  // query string lives in contextJson.url — pathname alone loses ?id= / ?tab=.
  page        String?
  // Auto-captured browser context at submit time: full URL (incl. query), viewport
  // size, device pixel ratio, browser/OS, light-vs-dark theme, and recent console
  // errors. Makes "where is this feedback / what was on screen" answerable without
  // a screenshot — a cut-off button is usually a viewport problem.
  contextJson String?
  status      String   @default("NEW")
  userId      String?
  userEmail   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Candidate {
  id                   String                 @id @default(cuid())
  firstName            String?
  lastName             String?
  displayName          String
  normalizedName       String?
  primaryEmail         String?
  normalizedEmail      String?
  primaryPhone         String?
  normalizedPhone      String?
  currentTitle         String?
  status               String                 @default("ACTIVE")
  stage                String?
  scanExcludedReason   String?
  scanExcludedNote     String?
  scanExcludedAt       DateTime?
  scanExcludedBy       String?
  owner                String?
  source               String?
  // Where this profile originated. Internal only — never surfaced to recruiters.
  // PAYCOM | JAZZ | MANUAL. Lets historical (Jazz) records live alongside live
  // ones as ordinary candidates, and keeps imports fully separable/reversible.
  origin               String                 @default("PAYCOM")
  jazzCandidateNumber  String?
  historicalSourceId   String?
  tagsJson             String?
  foldersJson          String?
  prosJson             String?
  consJson             String?
  // Travel loyalty numbers — auto-pulled into new trips (see TravelTrip).
  frequentFlyer        String?
  hotelLoyalty         String?
  rentalLoyalty        String?
  originalFieldsJson   String?
  sourceHistoryJson    String?
  mergeHistoryJson     String?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  contacts             CandidateContact[]
  notes                CandidateNote[]
  files                CandidateFile[]
  applications         CandidateApplication[]
  interviews           Interview[]
  metrics              CandidateMetric[]
  duplicateAsPrimary   DuplicateReviewItem[]  @relation("DuplicateCandidatePrimary")
  duplicateAsSecondary DuplicateReviewItem[]  @relation("DuplicateCandidateSecondary")
  importRows           ImportRow[]
  travelTrips          TravelTrip[]
  historicalSource     HistoricalSource?      @relation(fields: [historicalSourceId], references: [id], onDelete: SetNull)
  timelineEvents       TimelineEvent[]
  candidateTags        CandidateTag[]
  aiSummary            CandidateAiSummary?
  communications       CandidateCommunication[]
  questionnaireAnswers CandidateQuestionnaireAnswer[]

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedName])
  @@index([status])
  @@index([origin])
  @@index([jazzCandidateNumber])
  @@index([historicalSourceId])
}

model CandidateContact {
  id          String    @id @default(cuid())
  candidateId String
  type        String
  label       String?
  value       String
  normalized  String?
  isPrimary   Boolean   @default(false)
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([type, normalized])
}

model CandidateNote {
  id          String     @id @default(cuid())
  candidateId String
  authorId    String?
  body        String
  source      String?
  sourceRef   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([candidateId])
}

model CandidateMetric {
  id            String   @id @default(cuid())
  candidateId   String
  key           String
  label         String
  valueNumber   Float?
  valueText     String?
  unit          String?
  status        String   @default("SUGGESTED")
  sourceFileId  String?
  sourceSnippet String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, key])
  @@index([candidateId])
  @@index([key])
}

model CandidateFile {
  id               String    @id @default(cuid())
  candidateId      String?
  originalFilename String
  displayFilename  String
  storageKey        String?
  mimeType          String?
  sizeBytes         Int?
  source            String?
  documentType      String?
  expiresAt         DateTime?
  metadataJson      String?
  extractedText     String?
  textExtractedAt   DateTime?
  uploadedAt        DateTime  @default(now())
  renamedAt         DateTime?
  archivedAt        DateTime?
  updatedAt         DateTime  @updatedAt

  candidate         Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([displayFilename])
}

model Job {
  id                    String                 @id @default(cuid())
  sourceJobId           String?
  jobReqId              String?
  recruiter             String?
  title                 String
  normalizedTitle       String?
  city                  String?
  state                 String?
  postal                String?
  department            String?
  openedDate            DateTime?
  filledDate            DateTime?
  status                String                 @default("OPEN")
  activeStatus          String?
  source                String?
  sourceFilename        String?
  importedAt            DateTime?
  rawJobDescriptionHtml String?
  jobDescriptionText    String?
  rawMinimumRequirements String?
  rawPayScale           String?
  originalFieldsJson    String?
  isPilotRole           Boolean                @default(false)
  isPilotLeadershipRole Boolean                @default(false)
  isOldRole             Boolean                @default(false)
  aircraftTypesJson     String?
  pilotSeat             String?
  roleCategory          String?
  baseLocation          String?
  paySummary            String?
  scheduleSummary       String?
  mergedIntoJobId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  applications          CandidateApplication[]
  interviews            Interview[]
  pilotRequirements     PilotRequirement[]     @relation("JobToPilotRequirements")
  jobPosts              JobPost[]              @relation("RecruitingJobToJobPosts")
  importRows            ImportRow[]
  mergedIntoJob         Job?                   @relation("JobMerges", fields: [mergedIntoJobId], references: [id], onDelete: SetNull)
  mergedJobs            Job[]                  @relation("JobMerges")

  @@index([sourceJobId])
  @@index([jobReqId])
  @@index([normalizedTitle])
  @@index([status])
  @@index([isPilotRole])
  @@index([mergedIntoJobId])
}

model PilotRequirement {
  id                         String                    @id @default(cuid())
  sourceJobRecordId           String?
  title                      String
  normalizedTitle            String?
  fleetPositionSlug          String?
  advertisedTitle            String?
  linkedFleetPositionSlugs   String?                   // JSON array of additional fleet-position slugs for dual-aircraft roles
  status                     String                    @default("ACTIVE")
  reviewStatus               String                    @default("DRAFT")
  operatorType               String?
  requirementVersion         Int                       @default(1)
  roleCategory               String                    @default("Pilot")
  pilotSeat                  String?
  aircraftTypesJson          String?
  aircraftSeriesJson         String?
  aircraftAliasesJson        String?
  baseCity                   String?
  baseState                  String?
  baseAirport                String?
  payScaleRaw                String?
  salaryMin                  Int?
  salaryMax                  Int?
  signOnBonus                Int?
  scheduleRaw                String?
  rotation                   String?
  locationFitRequirements    String?
  scheduleFitRequirements    String?
  rawMinimumRequirements     String?
  originalJobDescriptionText String?
  originalJobDescriptionHtml String?
  extractionConfidence       Int?
  extractionWarningsJson     String?
  manualOverrideNotes        String?
  sourceHistoryJson          String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  lastReviewedAt             DateTime?

  sourceJobRecord            Job?                      @relation("JobToPilotRequirements", fields: [sourceJobRecordId], references: [id], onDelete: SetNull)
  gates                      PilotRequirementGate[]
  changes                    PilotRequirementChange[]
  jobPosts                   JobPost[]                 @relation("PilotRequirementToJobPosts")
  applications               CandidateApplication[]
  managedVariants            ManagedVariant[]

  @@index([normalizedTitle])
  @@index([status])
  @@index([pilotSeat])
}

// A specific managed aircraft (by tail number) operated under a canonical role.
// The role's qualifications/gates are shared; a variant only carries the
// per-aircraft operational differences: pay, base, schedule, tail number.
model ManagedVariant {
  id                 String           @id @default(cuid())
  pilotRequirementId String
  tailNumber         String
  name               String?
  baseCity           String?
  baseState          String?
  baseAirport        String?
  payScaleRaw        String?
  scheduleSummary    String?
  notes              String?
  status             String           @default("ACTIVE")
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  pilotRequirement   PilotRequirement @relation(fields: [pilotRequirementId], references: [id], onDelete: Cascade)

  @@index([pilotRequirementId])
}

model RequirementCatalogItem {
  id             String                   @id @default(cuid())
  key            String                   @unique
  label          String
  category       String
  valueType      String
  description    String?
  defaultEnabled Boolean                  @default(false)
  sortOrder      Int                      @default(0)
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  gates          PilotRequirementGate[]

  @@index([category])
}

model PilotRequirementGate {
  id                   String                 @id @default(cuid())
  pilotRequirementId    String
  catalogItemId         String?
  key                   String
  label                 String
  category              String
  valueType             String
  enabled               Boolean                @default(false)
  numericValue          Int?
  textValue             String?
  evidenceText          String?
  sortOrder             Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  pilotRequirement      PilotRequirement       @relation(fields: [pilotRequirementId], references: [id], onDelete: Cascade)
  catalogItem           RequirementCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([pilotRequirementId])
  @@index([key])
  @@index([category])
}

model PilotRequirementChange {
  id                  String            @id @default(cuid())
  pilotRequirementId   String
  changeNote           String?
  changedFieldsJson    String?
  previousValuesJson   String?
  newValuesJson        String?
  changedBy            String?
  changedAt            DateTime          @default(now())

  pilotRequirement     PilotRequirement  @relation(fields: [pilotRequirementId], references: [id], onDelete: Cascade)

  @@index([pilotRequirementId])
}

model CandidateApplication {
  id                  String             @id @default(cuid())
  candidateId          String
  jobId                String?
  pilotRequirementId   String?
  sourceApplicationId  String?
  status               String?
  stage                String?
  disposition          String?
  source               String?
  appliedAt            DateTime?
  // Historical (Jazz) application support. origin mirrors Candidate.origin so the
  // live pipeline and the archive share one table; "Historical Applications" on
  // the profile is just an origin=JAZZ filter, not a second table.
  origin               String             @default("PAYCOM")
  jazzApplicationNumber String?
  historicalJobTitle   String?
  recruiterName        String?
  hiringManager        String?
  rejectionReason      String?
  decidedAt            DateTime?
  historicalSourceId   String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  candidate            Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                  Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  pilotRequirement     PilotRequirement?  @relation(fields: [pilotRequirementId], references: [id], onDelete: SetNull)
  historicalSource     HistoricalSource?  @relation(fields: [historicalSourceId], references: [id], onDelete: SetNull)
  questionnaireAnswers CandidateQuestionnaireAnswer[]

  @@index([candidateId])
  @@index([jobId])
  @@index([pilotRequirementId])
  @@index([origin])
  @@index([jazzApplicationNumber])
  @@index([historicalSourceId])
}

model Interview {
  id                  String     @id @default(cuid())
  candidateId          String
  jobId                String?
  title                String
  interviewType        String     @default("RECRUITER_SCREEN")
  startDateTime        DateTime
  endDateTime          DateTime?
  timezone             String?
  interviewer          String?
  attendeesJson        String?
  location             String?
  meetingUrl           String?
  notes                String?
  status               String     @default("SCHEDULED")
  source               String?
  googleCalendarId     String?
  googleEventId        String?
  lastSyncedAt         DateTime?
  syncStatus           String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  candidate            Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                  Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  scorecards           InterviewScorecard[]

  @@index([candidateId])
  @@index([jobId])
  @@index([startDateTime])
}

// One interviewer's independent scorecard for an interview. Multiple per
// interview (one per interviewer). Items are rated questions (4-point rubric);
// stored as JSON so the question set can be tailored per scorecard.
model InterviewScorecard {
  id             String    @id @default(cuid())
  interviewId    String
  interviewer    String    // name, from the team roster (or typed)
  recommendation String?   // STRONG_YES | YES | NO | STRONG_NO
  itemsJson      String    @default("[]") // [{ q: string, rating: RatingKey | null }]
  comments       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model GoogleCalendarConnection {
  id                 String   @id @default(cuid())
  accountEmail       String?
  calendarId         String?
  syncDirection      String   @default("LOCAL_ONLY")
  accessTokenHint    String?
  refreshTokenStored Boolean  @default(false)
  syncToken          String?
  lastSyncedAt       DateTime?
  lastSyncStatus     String?
  lastSyncError      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ImportBatch {
  id            String      @id @default(cuid())
  sourceType    String
  sourceFilename String?
  status        String      @default("PENDING")
  rowCount      Int         @default(0)
  importedCount Int         @default(0)
  skippedCount  Int         @default(0)
  warningCount  Int         @default(0)
  errorCount    Int         @default(0)
  summaryJson   String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  rows          ImportRow[]
}

model ImportRow {
  id          String     @id @default(cuid())
  importBatchId String
  rowNumber    Int?
  rawJson      String
  status       String    @default("PENDING")
  warningJson  String?
  errorJson    String?
  candidateId  String?
  jobId        String?
  createdAt    DateTime  @default(now())

  importBatch  ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  candidate    Candidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  job          Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@index([candidateId])
  @@index([jobId])
}

model DuplicateReviewItem {
  id                   String     @id @default(cuid())
  reviewType            String
  status                String     @default("OPEN")
  reason                String?
  confidence            String?
  primaryCandidateId    String?
  secondaryCandidateId  String?
  primaryJobId          String?
  secondaryJobId        String?
  payloadJson           String?
  createdAt             DateTime   @default(now())
  resolvedAt            DateTime?

  primaryCandidate      Candidate? @relation("DuplicateCandidatePrimary", fields: [primaryCandidateId], references: [id], onDelete: SetNull)
  secondaryCandidate    Candidate? @relation("DuplicateCandidateSecondary", fields: [secondaryCandidateId], references: [id], onDelete: SetNull)

  @@index([reviewType])
  @@index([status])
  @@index([primaryCandidateId])
  @@index([secondaryCandidateId])
}

model AuditEvent {
  id          String    @id @default(cuid())
  actorId     String?
  eventType   String
  entityType  String
  entityId    String?
  summary     String?
  payloadJson String?
  createdAt   DateTime  @default(now())

  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([entityType, entityId])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  permission String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String?
  userEmail     String?
  activityType  String
  description   String
  entityType    String?
  entityId      String?
  metadata      String?
  createdAt     DateTime @default(now())

  user          User?    @relation("ActivityLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// Records that two jobs have been reviewed and confirmed NOT to be duplicates.
// jobIdA/jobIdB are stored sorted (jobIdA < jobIdB) so each pair is unique.
model JobDuplicateDismissal {
  id        String   @id @default(cuid())
  jobIdA    String
  jobIdB    String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([jobIdA, jobIdB])
  @@index([jobIdA])
  @@index([jobIdB])
}

// Captures exactly what moved during a job merge so it can be precisely reversed.
// applicationIds / interviewIds / jobPostIds are JSON arrays of the moved record IDs.
model JobMergeRecord {
  id             String    @id @default(cuid())
  primaryJobId   String
  secondaryJobId String
  applicationIds String    @default("[]")
  interviewIds   String    @default("[]")
  jobPostIds     String    @default("[]")
  previousStatus String?
  mergedBy       String?
  mergedAt       DateTime  @default(now())
  undone         Boolean   @default(false)
  undoneAt       DateTime?

  @@index([secondaryJobId])
  @@index([primaryJobId])
  @@index([undone])
}

// =====================================================================
// Compliments by SkyShare — employee recognition & rewards
// Per-repo convention, status/category columns are String (not Prisma
// enums); the allowed values + points map live in lib/compliments/constants.ts.
// =====================================================================

// Company values (teamwork, innovation, ...). Every recognition is tagged
// to one or more of these and inherits the value's color.
model RecognitionValue {
  id           String        @id @default(cuid())
  name         String        @unique
  // teamwork | innovation | leadership | customerFocus | growthMindset | integrity
  colorKey     String
  sortOrder    Int           @default(0)
  recognitions Recognition[]
}

model Recognition {
  id            String               @id @default(cuid())
  giver         NewHire              @relation("giver", fields: [giverId], references: [id], onDelete: Cascade)
  giverId       String
  recipient     NewHire              @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId   String
  message       String
  values        RecognitionValue[]   // many-to-many
  strength      String               @default("GREAT") // GOOD | GREAT | AMAZING (see RecognitionStrength)
  pointsAwarded Int
  likes         RecognitionLike[]
  comments      RecognitionComment[]
  createdAt     DateTime             @default(now())

  @@index([recipientId])
  @@index([giverId])
  @@index([createdAt])
}

model RecognitionLike {
  id            String      @id @default(cuid())
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  recognitionId String
  // The actor who liked: a NewHire id (seeded peer) or the logged-in User id
  // (live operator). Stored as an opaque string — display only needs the count.
  actorId       String
  createdAt     DateTime    @default(now())

  @@unique([recognitionId, actorId])
  @@index([recognitionId])
}

model RecognitionComment {
  id            String      @id @default(cuid())
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  recognitionId String
  authorId      String      // NewHire id (seeded peer) or User id (live operator)
  authorName    String      // denormalized for display, avoids a cross-table join
  body          String
  createdAt     DateTime    @default(now())

  @@index([recognitionId])
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String?
  category    String       // GIFT_CARD | EXPERIENCE | SWAG | CHARITY (see RewardCategory)
  pointCost   Int
  icon        String       // lucide-react icon name (resolved at render)
  available   Boolean      @default(true)
  redemptions Redemption[]

  @@index([category])
}

model Redemption {
  id          String   @id @default(cuid())
  newHire     NewHire  @relation(fields: [newHireId], references: [id], onDelete: Cascade)
  newHireId   String
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId    String
  pointsSpent Int
  createdAt   DateTime @default(now())

  @@index([newHireId])
  @@index([rewardId])
}

// ============================================================================
//  Scheduling / public booking ("schedule with me" — Calendly replacement)
//  Each employee is a BookingHost with a recurring weekly schedule, optional
//  per-date overrides (vacation/holiday/custom hours), and one or more booking
//  types. Public bookings land on the shared Google Calendar tagged with the
//  host id so per-person availability works even on one shared calendar.
//  Candidate/job/interview links are stored as plain ids (no relations) so this
//  block is self-contained and additive.
// ============================================================================

model BookingHost {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  email             String?  // @skyshare email; also used for free/busy lookup
  role              String   @default("RECRUITER") // RECRUITER | HIRING_MANAGER | OTHER
  // JSON array of canonical department keys this person can interview for
  // (e.g. ["crew","fbo"]). A person may belong to multiple departments.
  departmentsJson   String?
  title             String?
  avatarUrl         String?  // small profile photo (data URL) shown on the calendar
  timezone          String   @default("America/Denver")
  // Optional Google calendar id (usually the @skyshare email) to read this
  // person's real free/busy without them doing anything — requires the service
  // account to have domain-wide delegation or free/busy sharing (one-time admin step).
  calendarId        String?
  // Editable booking settings
  minNoticeHours    Int      @default(6)
  bookingWindowDays Int      @default(90)
  maxPerDay         Int?     // null = unlimited
  bufferMinutes     Int      @default(0) // 0 or 10
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  weeklyRules  AvailabilityRule[]
  overrides    AvailabilityOverride[]
  bookingTypes BookingType[]
  bookings     Booking[]

  @@index([slug])
}

// Recurring weekly availability window (host-local time).
model AvailabilityRule {
  id          String      @id @default(cuid())
  hostId      String
  dayOfWeek   Int         // 0 = Sunday .. 6 = Saturday
  startMinute Int         // minutes from midnight (host tz)
  endMinute   Int
  host        BookingHost @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

// Per-date override: BLOCK = unavailable (vacation/holiday), CUSTOM = special hours.
// hostId null = applies to every host (org-wide holiday).
model AvailabilityOverride {
  id          String       @id @default(cuid())
  hostId      String?
  startDate   DateTime     @db.Date // inclusive
  endDate     DateTime     @db.Date // inclusive
  kind        String       @default("BLOCK") // BLOCK | CUSTOM
  startMinute Int? // CUSTOM only
  endMinute   Int? // CUSTOM only
  label       String?
  createdAt   DateTime     @default(now())
  host        BookingHost? @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

model BookingType {
  id              String      @id @default(cuid())
  hostId          String
  name            String
  kind            String      @default("INTERVIEW") // INTERVIEW | MEETING
  durationMinutes Int         @default(30) // 30 | 45 | 60
  bufferMinutes   Int? // overrides host buffer (0 or 10); null = use host
  location        String? // e.g. "Video — Zoom" or a phone note
  description     String?
  isActive        Boolean     @default(true)
  sortOrder       Int         @default(0)
  host            BookingHost @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([hostId])
}

model Booking {
  id               String       @id @default(cuid())
  hostId           String
  bookingTypeId    String?
  startDateTime    DateTime
  endDateTime      DateTime
  timezone         String       @default("America/Denver") // invitee timezone
  inviteeName      String
  inviteeEmail     String
  inviteePhone     String?
  notes            String?
  status           String       @default("CONFIRMED") // CONFIRMED | CANCELLED
  // Plain id links (no relations on purpose — keeps this block self-contained)
  candidateId      String?
  jobId            String?
  interviewId      String?
  googleEventId    String?
  googleCalendarId String?
  cancelToken      String?      @unique
  source           String?      @default("public-booking")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  host        BookingHost  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookingType BookingType? @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)

  @@index([hostId])
  @@index([startDateTime])
  @@index([status])
}

// Reusable interview question bank. Each question is tagged by category, an
// optional core value, and the department(s) it suits, so an interview guide
// can later be assembled to match a role / core values / situation.
model InterviewQuestion {
  id              String   @id @default(cuid())
  text            String
  category        String   @default("BEHAVIORAL") // BEHAVIORAL | SITUATIONAL | TECHNICAL | EXPERIENCE | OTHER
  coreValue       String?  // colorKey from COMPANY_VALUES (e.g. "teamwork"); null = none
  departmentsJson String?  // JSON array of canonical department keys; empty/null = applies to all
  guidance        String?  // what a strong answer looks like (interviewer note)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ─── Historical Candidate Archive ──────────────────────────────────────────
// Records a single ingest of legacy ATS data (e.g. a JazzHR export). Every
// Candidate / CandidateApplication created by that ingest points back here, so
// an import is named, auditable, and removable as one unit.
model HistoricalSource {
  id            String   @id @default(cuid())
  system        String                       // JAZZ
  label         String                       // e.g. "Jazz export — 2025-06-16"
  rootPath      String?
  importBatchId String?
  createdAt     DateTime @default(now())

  candidates    Candidate[]
  applications  CandidateApplication[]
}

// One entry in a candidate's unified chronology. Synthesized from applications,
// interviews, notes, and file uploads (live + historical) so the profile shows
// a single timeline regardless of where each event came from.
model TimelineEvent {
  id          String    @id @default(cuid())
  candidateId String
  type        String    // APPLIED | INTERVIEWED | OFFER | REJECTED | HIRED | NOTE | INTERVIEW_NOTE | RESUME_UPLOADED | CERT_UPDATED
  title       String
  detail      String?
  occurredAt  DateTime
  origin      String    @default("PAYCOM")
  sourceType  String?   // Application | Interview | Note | File
  sourceId    String?
  createdAt   DateTime  @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, occurredAt])
  @@index([type])
}

// Normalized tag (replaces the legacy tagsJson string column over time).
model Tag {
  id         String         @id @default(cuid())
  label      String         @unique
  normalized String         @unique
  color      String?
  createdAt  DateTime       @default(now())

  candidates CandidateTag[]
}

model CandidateTag {
  candidateId String
  tagId       String
  source      String?   // JAZZ | MANUAL
  createdAt   DateTime  @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([candidateId, tagId])
  @@index([tagId])
}

// AI-generated narrative summary of a candidate's full history. Regenerated when
// underlying data changes (inputHash guards against needless regeneration).
model CandidateAiSummary {
  id          String    @id @default(cuid())
  candidateId String    @unique
  summary     String
  model       String?
  inputHash   String?
  generatedAt DateTime  @default(now())
  staleAt     DateTime?

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

// A single archived email/message between the team and a candidate (Communication
// History — imported from the legacy ATS). Linked to the candidate; the two
// parties are kept as raw addresses so direction can be derived for display.
model CandidateCommunication {
  id                 String    @id @default(cuid())
  candidateId        String
  jazzCommId         String?
  jazzProspectId     String?
  senderEmail        String?
  recipientEmail     String?
  cc                 String?
  bcc                String?
  subject            String?
  body               String?
  sentAt             DateTime?
  origin             String    @default("JAZZ")
  historicalSourceId String?
  createdAt          DateTime  @default(now())

  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, sentAt])
  @@index([jazzCommId])
}

// A single question/answer from a Jazz application questionnaire (e.g. the HR
// Generalist or pilot questionnaires). Linked to the candidate and, when known,
// the specific application it was answered for.
model CandidateQuestionnaireAnswer {
  id                String    @id @default(cuid())
  candidateId       String
  applicationId     String?
  questionnaireName String?
  question          String?
  answer            String?
  origin            String    @default("JAZZ")
  createdAt         DateTime  @default(now())

  candidate         Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application       CandidateApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Events & Outreach — career fairs, school visits, conferences: who is going,
// what we bring, what still needs doing, and when to reorder the swag.
// ---------------------------------------------------------------------------

model Event {
  id        String    @id @default(cuid())
  name      String
  // CAREER_FAIR | SCHOOL | CONFERENCE | COMMUNITY | AIRSHOW | OTHER
  type      String    @default("CAREER_FAIR")
  // PLANNED | CONFIRMED | COMPLETE | CANCELED
  status    String    @default("PLANNED")
  startsAt  DateTime
  endsAt    DateTime?
  venue     String?
  city      String?
  state     String?
  website   String?
  // Who owns the event internally. Optional so an event can be logged before
  // an owner is picked; SetNull keeps the event if the employee record goes.
  ownerId   String?
  budget    Float?
  currency  String    @default("USD")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner     NewHire?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  attendees EventAttendee[]
  supplies  EventSupply[]
  tasks     EventTask[]

  @@index([status])
  @@index([startsAt])
  @@index([ownerId])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  newHireId String
  // PENDING | CONFIRMED | DECLINED
  status    String   @default("PENDING")
  // Free text — e.g. "Booth lead", "Pilot on the stand".
  role      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  newHire NewHire @relation(fields: [newHireId], references: [id], onDelete: Cascade)

  @@unique([eventId, newHireId])
  @@index([eventId])
  @@index([newHireId])
}

// The stock room. On-hand counts are maintained by hand; "committed" (allocated
// to upcoming events) is derived from EventSupply, never stored.
model SupplyItem {
  id               String   @id @default(cuid())
  name             String
  // SWAG | PRINT | BOOTH | APPAREL | OTHER
  category         String   @default("SWAG")
  // What one unit is — "each", "box of 50", "case".
  unit             String   @default("each")
  onHand           Int      @default(0)
  // Reorder when the projected count (on hand minus committed) drops to or
  // below this. 0 means "only tell me when it is gone".
  reorderThreshold Int      @default(0)
  vendor           String?
  reorderUrl       String?
  unitCost         Float?
  currency         String   @default("USD")
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  eventSupplies EventSupply[]

  @@index([category])
  @@index([active])
}

// One line of "what we are bringing" to an event. supplyItemId is optional so a
// one-off thing (a borrowed banner) can be listed without stocking it.
model EventSupply {
  id           String   @id @default(cuid())
  eventId      String
  supplyItemId String?
  label        String
  quantity     Int      @default(1)
  packed       Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem? @relation(fields: [supplyItemId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([supplyItemId])
}

// "What we need" — the per-event to-do list (order the banner, ship the box).
model EventTask {
  id        String    @id @default(cuid())
  eventId   String
  label     String
  owner     String?
  dueAt     DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
