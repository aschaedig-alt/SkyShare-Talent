node_modules
.next
# Verification builds (npm run build:check) land here so they never corrupt the
# .next a dev server is using. See scripts/build-check.mjs.
.next-check
# Dry-run output from scripts/review-pdf-form-extract.ts — regenerate, don't commit.
pdf-form-extract-review.md
out
*.log
prisma/dev.db
prisma/dev.db-journal
prisma/generated
.env.local
.env.vercel.local
storage/

.vercel

.env*

# Local run-state from one-off maintenance scripts (undo records, review files)
scripts/_*_output/

# TypeScript incremental build cache — machine-generated, regenerates on every build
*.tsbuildinfo

# Vendored mermaid browser bundle — generated by scripts/vendor-mermaid.mjs (see package.json build/dev)
/public/vendor/mermaid.min.js

# Per-session "what I am working on" claims (see CLAUDE.md, "Claiming what you are
# working on"). One file per session, never a shared one. These describe the state
# of THIS working tree, not the repo — they must never be committable, or a claim
# from a dead session would ship and be believed.
.claude/claims/

# PERSONAL, PER-MACHINE Claude Code settings. The tool WRITES to this file itself
# every time somebody approves a permission, so while it was tracked it was
# permanently dirty and every session read it as a sibling's uncommitted work and
# refused to stage it — which is why it went three weeks without a commit and
# collected ~50 dead one-off rules. It was only ever tracked by accident (swept
# into 9ec4c8f on 2026-06-08). Shared, deliberate rules belong in the committed
# .claude/settings.json instead.
.claude/settings.local.json
